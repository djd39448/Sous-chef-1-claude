# Sous Chef backend — copy this file to .env and fill in the values.
# .env is gitignored; never commit real secrets.

# HTTP listen port. Optional; defaults to 8080.
PORT=8080

# Supabase PostgreSQL connection string. Use the connection string from
# Supabase → Project Settings → Database. The backend connects directly and
# enforces per-user ownership in code (it bypasses row-level security).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase project JWT secret, from Supabase → Project Settings → API →
# JWT Settings → "JWT Secret". Used to verify Supabase Auth access tokens
# (HS256) presented by the iOS app on the Authorization header.
SUPABASE_JWT_SECRET=

# OpenAI API key with billing enabled. The original app proxied OpenAI through
# Replit; this port calls OpenAI directly (see contract Decision D4).
OPENAI_API_KEY=
